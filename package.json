{
  "name": "@routex/sui",
  "version": "1.0.0",
  "description": "Headless swap routing for Sui. Best price across all liquidity. Atomic PTB execution.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "tsx tests/integration.test.ts",
    "postinstall": "node scripts/patch-sui-compat.mjs"
  },
  "keywords": [
    "sui",
    "defi",
    "swap",
    "routing",
    "dex",
    "aggregator",
    "ptb"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cetusprotocol/cetus-sui-clmm-sdk": "^5.4.0",
    "@mysten/deepbook-v3": "^1.4.1",
    "@mysten/sui": "^2.17.0",
    "aftermath-ts-sdk": "^2.0.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
